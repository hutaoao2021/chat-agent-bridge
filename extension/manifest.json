{
  "manifest_version": 3,
  "name": "Chat Agent Bridge",
  "version": "0.2.0",
  "description": "Per-chat local MCP task continuation with explicit pairing and pause controls.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Chat Agent Bridge"},
  "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_idle"}],
  "web_accessible_resources": [{"resources": ["selectors.js", "continuation.js"], "matches": ["https://chatgpt.com/*"]}]
}
